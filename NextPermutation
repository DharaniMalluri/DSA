class Solution {
    public void nextPermutation(int[] nums) {
       int i=nums.length-2;
       //finding pivot
       while(i>=0&&nums[i]>=nums[i+1])
            i--;
        //swap pivot with the  first element which is greater than pivot from pivot
        if(i>=0)
        {
            int j=nums.length-1;
            while(nums[j]<=nums[i])
                    j--;
            int temp=nums[i];
            nums[i]=nums[j];
            nums[j]=temp;
        }
        int start=i+1;
        int end=nums.length-1;
        while(start<end)
        {
            int temp=nums[start];
            nums[start]=nums[end];
            nums[end]=temp;
            start++;
            end--;
        }
    }
}
