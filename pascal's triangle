class Pascal{
public List<List<Integer>> m1(int r)
{
List<List<Integer>> result=new ArrayList<>();
for(int i=0;i<r;i++)
{
List<Integer> row=new ArrayList<>();
row.add(1);//first row
//to calculate middle elements
for(int j=1;j<i;j++)
{
row.add(result.get(i-1).get(j-1)+result.get(i-1).get(j));
}
if(i>0)
  row.add(1);//to add a 1 at end of each row 
result.add(row);
}
return result;
}
